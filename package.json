{
  "name": "@devs-des1re/releaselog",
  "version": "1.0.0",
  "description": "Generate structured release notes from Git history and publish them as GitHub Releases.",
  "license": "MIT",
  "author": "devs-des1re",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devs-des1re/releaselog.git"
  },
  "bugs": {
    "url": "https://github.com/devs-des1re/releaselog/issues"
  },
  "homepage": "https://github.com/devs-des1re/releaselog",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && ncc build src/index.ts -o dist --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^8.0.1",
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@anthropic-ai/sdk": "^1.4.0",
    "ai": "^7.0.162",
    "handlebars": "^4.7.10",
    "openai": "^7.50.0",
    "semver": "^7.8.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
